# deploy/.env — copy this file to deploy/.env and fill it in. deploy/.env is
# git-ignored. On the GCP VM it is written by the startup script from Secret
# Manager; the GitHub token is NOT kept here (deploy/sweep.sh reads it at run
# time).

# Database password, for the compose network only (the database is never
# published). Any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=

# What the front door serves. A hostname (e.g. 203-0-113-7.sslip.io), or :443
# to answer any name.
SITE_ADDRESS=:443
# "internal": Caddy's own certificate (browser warning; works with the
# firewall limited to your IP). An e-mail address: Let's Encrypt (needs ports
# 80 and 443 open to the internet while the certificate is issued).
TLS=internal

# The one login. Hash the password with:
#   docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your password'
# Write the hash in single quotes: it contains $ signs.
LOGIN_USER=admin
LOGIN_HASH=

# Ports on the host (change only for local testing).
HTTP_PORT=80
HTTPS_PORT=443

# How many repositories a sweep scans at once.
SWEEP_CONCURRENCY=2

# NuGuard, the opt-in AI code-rule and inventory scanner (DEPLOY.md,
# "NuGuard"). Leave NUGUARD_URL empty to keep it off; nothing else changes.
# The URL is the sidecar's loopback address inside the scan worker.
NUGUARD_URL=
#NUGUARD_URL=http://127.0.0.1:8085
# The SHA-256 of the API key, from `nuguard serve keygen --id vulnframework`.
# The key itself is not kept here: deploy/scanworker.sh reads it from
# $VULNFRAMEWORK_NUGUARD_API_KEY when it starts the worker.
NUGUARD_API_KEY_SHA256=
NUGUARD_IMAGE=nuguard-service:0.9.15
# Optional: the defaults for a fleet never configured in the interface: the
# tools to ask for (default nga-rules,atlas,semgrep), posture observations
# for the inventory, and the per-repository time limit.
#NUGUARD_TOOLS=nga-rules,atlas,semgrep
#NUGUARD_INCLUDE_POSTURE=false
#NUGUARD_TIMEOUT=10m
# Optional: the ceiling. Security owners choose NuGuard's settings in the
# interface ("AI scanning"), within these and never beyond them; the worker
# refuses to start if a default above exceeds them, and clips a stored
# setting that does, saying so on the scan.
#NUGUARD_ALLOW_TOOLS=nga-rules,atlas,semgrep
#NUGUARD_ALLOW_POSTURE=true
#NUGUARD_MAX_TIMEOUT=10m
# The largest AI-SBOM a scan may keep, in bytes; a larger one is not stored.
#NUGUARD_SBOM_MAX_BYTES=4194304

## worker
docker run -d --rm --name vulnframework-scanworker --add-host=host.docker.internal:host-gateway -v <WORK>/clones:/repos:ro -v <WORK>/home/bin/orchestrator-linux-arm64:/opt/vf/orchestrator:ro -v <ROOT>/vulnframework/config:/opt/vf/config:ro -v vulnframework-scanhome:/home/scanner -e SEMGREP_SEND_METRICS=off -e SEMGREP_ENABLE_VERSION_CHECK=0 -e VULNFRAMEWORK_NUGUARD_API_KEY -v <WORK>/home/bin/loopbridge-linux-arm64:/opt/vf/loopbridge:ro --entrypoint /bin/sh vulnframework-scanner:v1 -c $'/opt/vf/loopbridge -listen 127.0.0.1:8090 -to host.docker.internal:8090 -ready /tmp/loopbridge.ready &\ni=0; while [ ! -e /tmp/loopbridge.ready ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done\nexec /opt/vf/orchestrator "$@"' orchestrator -dsn postgres://vulnframework:vulnframework@host.docker.internal:5433/vulnframework\?sslmode=disable -workdir /repos -tools /opt/vf/config/tools.lock -calibration /opt/vf/config/calibration.yaml -policy /opt/vf/config/policy.yaml -kev-url https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json -epss-url https://epss.empiricalsecurity.com/epss_scores-current.csv.gz -nuguard-url http://127.0.0.1:8090 -nuguard-tools '' -nuguard-include-posture=false -nuguard-timeout 10m -nuguard-allow-tools nga-rules\,atlas\,semgrep -nuguard-allow-posture=true -nuguard-max-timeout 10m -nuguard-sbom-max-bytes 4194304 -worker -scan-timeout 15m
## sweep
docker run --rm --add-host=host.docker.internal:host-gateway -v <WORK>/clones:/repos:ro -v <WORK>/home/bin/orchestrator-linux-arm64:/opt/vf/orchestrator:ro -v <ROOT>/vulnframework/config:/opt/vf/config:ro -v vulnframework-scanhome:/home/scanner -e SEMGREP_SEND_METRICS=off -e SEMGREP_ENABLE_VERSION_CHECK=0 -e VULNFRAMEWORK_NUGUARD_API_KEY -v <WORK>/home/bin/loopbridge-linux-arm64:/opt/vf/loopbridge:ro --entrypoint /bin/sh vulnframework-scanner:v1 -c $'/opt/vf/loopbridge -listen 127.0.0.1:8090 -to host.docker.internal:8090 -ready /tmp/loopbridge.ready &\ni=0; while [ ! -e /tmp/loopbridge.ready ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done\nexec /opt/vf/orchestrator "$@"' orchestrator -dsn postgres://vulnframework:vulnframework@host.docker.internal:5433/vulnframework\?sslmode=disable -workdir /repos -tools /opt/vf/config/tools.lock -calibration /opt/vf/config/calibration.yaml -policy /opt/vf/config/policy.yaml -kev-url https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json -epss-url https://epss.empiricalsecurity.com/epss_scores-current.csv.gz -nuguard-url http://127.0.0.1:8090 -nuguard-tools '' -nuguard-include-posture=false -nuguard-timeout 10m -nuguard-allow-tools nga-rules\,atlas\,semgrep -nuguard-allow-posture=true -nuguard-max-timeout 10m -nuguard-sbom-max-bytes 4194304

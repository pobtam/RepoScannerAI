## worker
docker run -d --rm --name vulnframework-scanworker --add-host=host.docker.internal:host-gateway -v <WORK>/clones:/repos:ro -v <WORK>/home/bin/orchestrator-linux-arm64:/opt/vf/orchestrator:ro -v <ROOT>/vulnframework/config:/opt/vf/config:ro -v vulnframework-scanhome:/home/scanner -e SEMGREP_SEND_METRICS=off -e SEMGREP_ENABLE_VERSION_CHECK=0 --entrypoint /opt/vf/orchestrator vulnframework-scanner:v1 -dsn postgres://vulnframework:vulnframework@host.docker.internal:5433/vulnframework\?sslmode=disable -workdir /repos -tools /opt/vf/config/tools.lock -calibration /opt/vf/config/calibration.yaml -policy /opt/vf/config/policy.yaml -kev-url https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json -epss-url https://epss.empiricalsecurity.com/epss_scores-current.csv.gz -worker -scan-timeout 15m
## sweep
docker run --rm --add-host=host.docker.internal:host-gateway -v <WORK>/clones:/repos:ro -v <WORK>/home/bin/orchestrator-linux-arm64:/opt/vf/orchestrator:ro -v <ROOT>/vulnframework/config:/opt/vf/config:ro -v vulnframework-scanhome:/home/scanner -e SEMGREP_SEND_METRICS=off -e SEMGREP_ENABLE_VERSION_CHECK=0 --entrypoint /opt/vf/orchestrator vulnframework-scanner:v1 -dsn postgres://vulnframework:vulnframework@host.docker.internal:5433/vulnframework\?sslmode=disable -workdir /repos -tools /opt/vf/config/tools.lock -calibration /opt/vf/config/calibration.yaml -policy /opt/vf/config/policy.yaml -kev-url https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json -epss-url https://epss.empiricalsecurity.com/epss_scores-current.csv.gz

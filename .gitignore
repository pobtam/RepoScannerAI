# Node / Vite prototype harness
node_modules/
dist/
.vite/

# Go
*.test
*.out
/vulnframework/bin/

# Editor / OS
.DS_Store
.idea/
*.swp

# Scanner capture scratch
/vulnframework/testdata/repos/*/node_modules/
# Binaries from "go build ./cmd/<name>" run inside vulnframework/
/vulnframework/apiserver
/vulnframework/orchestrator
/vulnframework/vfctl
/vulnframework/fixworker
/vulnframework/scanworker

# The stack's secrets. Local settings belong in ~/.config/vulnframework/,
# outside the repository; these patterns catch a copy left here by mistake.
deploy/.env
deploy/runs/
.env
.env.*
*.env
env.real
!deploy/env.example
# Database backups (scripts/db.sh writes them outside the repository)
*.dump

# Terraform state, plans, variables and provider caches
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfstate*
deploy/terraform/**/*.tfplan
deploy/terraform/**/terraform.tfvars
deploy/terraform/**/.terraform.lock.hcl
